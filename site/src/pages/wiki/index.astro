---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getArtwork } from '../../data/artwork';
import { articles, categories, categoryLabel } from '../../data/wiki';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = ['dimensao-pokemon', 'arcanus', 'undergarden'].map(s => articles.find(a => a.slug === s)!);
---
<Base title="Wiki" description="Enciclopédia do Minecraft 2: conheça suas dimensões, portais, mecânicas especiais, combate e guias de exploração.">
  <section class="wiki-top"><div class="container wiki-top-inner"><span class="eyebrow"><span class="eyebrow-line"></span> A ENCICLOPÉDIA DO MINECRAFT 2</span><h1>Todo universo tem<br /><em>seus segredos.</em></h1><p>Descubra dimensões, sistemas e as regras que tornam o Minecraft 2 diferente. Uma wiki feita para acompanhar a aventura.</p><div class="wiki-search-wrap"><label class="sr-only" for="wiki-search">Pesquisar artigos da wiki</label><Icon name="search" size={21}/><input id="wiki-search" type="search" placeholder="Buscar dimensão, portal, magia, combate..." autocomplete="off" /><kbd>/</kbd></div><span class="wiki-top-caption">{articles.length} artigos disponíveis • Conteúdo sujeito a mudanças durante o desenvolvimento</span></div></section>
  <section class="container wiki-content" aria-labelledby="explore-wiki"><div class="section-heading wiki-explore-head"><div><span class="kicker">ENCONTRE O QUE PRECISA</span><h2 id="explore-wiki">Explore a <em>enciclopédia.</em></h2></div><p>Filtre por assunto ou pesquise pelo nome de um mundo, criatura ou sistema.</p></div>
    <div class="wiki-categories" role="group" aria-label="Filtrar artigos por categoria">{categories.map((c,i) => <button type="button" class:list={['filter-pill', { 'is-active': i===0 }]} data-filter={c.id} aria-pressed={i===0}>{c.label}</button>)}</div>
    <div class="wiki-list-header"><span id="wiki-result-count" aria-live="polite">Mostrando {articles.length} artigos</span><span>GUIAS & REFERÊNCIAS</span></div>
    <div class="wiki-article-grid" id="wiki-article-grid">
      {articles.map(a => <a class="wiki-list-card" href={`${base}/wiki/${a.slug}/`} data-article data-category={a.category} data-search={`${a.title} ${a.summary} ${a.introduction} ${a.eyebrow}`} style={`--realm-accent:${a.accent}`}>
        <span class="wiki-list-thumb"><img src={getArtwork(a.artwork)} alt="" loading="lazy"/></span>
        <span class="wiki-list-details"><span class="article-category">{categoryLabel(a.category)} · {a.status}</span><strong>{a.title}</strong><small>{a.summary}</small></span>
        <span class="wiki-list-arrow"><Icon name="arrowUpRight" size={19}/></span>
      </a>)}
    </div>
    <div class="wiki-empty" id="wiki-empty" hidden><Icon name="search" size={28}/><h3>Nenhum artigo encontrado</h3><p>Tente pesquisar outro termo ou selecionar uma categoria diferente.</p><button type="button" id="reset-search" class="btn btn-outline">Limpar filtros <Icon name="x" size={16}/></button></div>
  </section>
  <section class="container featured-realms"><div class="section-heading"><div><span class="kicker">COMECE POR AQUI</span><h2>Alguns mundos <em>para descobrir.</em></h2></div></div><div class="featured-realm-grid">{featured.map(a => <a href={`${base}/wiki/${a.slug}/`} class="featured-realm" style={`--realm-accent:${a.accent}`}><img src={getArtwork(a.artwork)} alt="" loading="lazy"/><span class="featured-realm-overlay"></span><span class="featured-realm-label">DIMENSÃO</span><span class="featured-realm-title">{a.title} <Icon name="arrowUpRight" size={19}/></span></a>)}</div></section>
  <div class="container notice-inline wiki-note"><Icon name="info" size={18}/><p>A wiki descreve tanto ideias de design quanto sistemas em implementação. Consulte o status de cada página: mecânicas planejadas não são garantidas na versão atual.</p></div>
  <script>
    const searchInput = document.querySelector<HTMLInputElement>('#wiki-search');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article]'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const resultCount = document.querySelector<HTMLElement>('#wiki-result-count');
    const emptyState = document.querySelector<HTMLElement>('#wiki-empty');
    const reset = document.querySelector<HTMLButtonElement>('#reset-search');
    let activeCategory = 'todas';
    const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    function refresh() {
      const query = normalize(searchInput?.value.trim() || '');
      let visible = 0;
      for (const card of cards) {
        const categoryMatches = activeCategory === 'todas' || card.dataset.category === activeCategory;
        const textMatches = normalize(card.dataset.search ?? '').includes(query);
        const matches = categoryMatches && textMatches;
        card.hidden = !matches;
        if (matches) visible++;
      }
      if (resultCount) resultCount.textContent = `Mostrando ${visible} ${visible === 1 ? 'artigo' : 'artigos'}`;
      if (emptyState) emptyState.hidden = visible > 0;
      filterButtons.forEach(btn => {
        const active = btn.dataset.filter === activeCategory;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    }
    filterButtons.forEach(btn => btn.addEventListener('click', () => { activeCategory = btn.dataset.filter || 'todas'; refresh(); }));
    searchInput?.addEventListener('input', refresh);
    reset?.addEventListener('click', () => {activeCategory = 'todas'; if (searchInput) {searchInput.value = ''; searchInput.focus();} refresh();});
    document.addEventListener('keydown', e => { if (e.key === '/' && !['INPUT','TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) {e.preventDefault(); searchInput?.focus();} });
    const searchParams = new URLSearchParams(window.location.search);
    if (searchInput && searchParams.has('q')) {searchInput.value = searchParams.get('q') || '';}
    if (categoriesFromURL(searchParams.get('categoria'))) activeCategory = searchParams.get('categoria') || 'todas';
    function categoriesFromURL(value: string|null) {return Boolean(value && filterButtons.some(btn => btn.dataset.filter === value));}
    refresh();
  </script>
</Base>
