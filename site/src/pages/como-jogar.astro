---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getArtwork } from '../data/artwork';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const guides = [
  {n:'01', title:'Comece pelo básico',tag:'PRIMEIROS PASSOS',desc:'Explore a região inicial, reúna recursos, estabeleça uma base e organize equipamentos de sobrevivência.',details:['Prepare comida, ferramentas, iluminação e um abrigo.','Marque o local da sua base antes de sair explorando.','Não carregue todos os seus recursos em viagens desconhecidas.'],link:'mundo-principal',label:'Sobre o Mundo Principal'},
  {n:'02', title:'Descubra novas dimensões',tag:'EXPLORAÇÃO',desc:'O Minecraft 2 reúne mundos com identidades diferentes. Conhecer os portais e as regras de cada local é parte da aventura.',details:['Estude a forma de acesso antes de construir um portal.','Leve recursos para retornar em segurança.','Alguns conteúdos e acessos ainda estão em fase de validação.'],link:'portais-personalizados',label:'Entenda os portais'},
  {n:'03', title:'Adapte seu estilo de jogo',tag:'SISTEMAS',desc:'Engenharia, magia, captura de Pokémon e equipamentos especiais são caminhos possíveis — cada um com seu espaço.',details:['Use a engenharia para ampliar suas construções.','Explore a dimensão Pokémon para conhecer a proposta de Cobblemon.','Informe-se sobre possíveis restrições mágicas em Arcanus.'],link:'cobblemon',label:'Conheça Cobblemon'},
  {n:'04', title:'Prepare-se para o inesperado',tag:'SOBREVIVÊNCIA',desc:'Os desafios não são iguais em todos os mundos. Equipamentos excelentes em um lugar podem exigir adaptações em outro.',details:['Tenha opções de combate e equipamentos de reposição.','Confira regras específicas como a penalidade de armas externas no Undergarden.','Faça expedições curtas antes de tentar aventuras maiores.'],link:'preparacao-de-expedicoes',label:'Guia de expedições'},
];
---
<Base title="Como jogar" description="Guia inicial do Minecraft 2: primeiros passos, dimensões, portais e dicas de sobrevivência para começar sua aventura.">
  <section class="inner-hero container play-hero"><div><span class="eyebrow"><span class="eyebrow-line"></span> GUIA DO JOGADOR</span><h1>Uma aventura maior<br />que você <em>imagina.</em></h1><p>É sua primeira vez no Minecraft 2? Comece por aqui. Este guia apresenta os conceitos sem revelar todos os segredos da exploração.</p><a class="text-link" href={`${base}/wiki/`}>Precisa de detalhes? Acesse a wiki <Icon name="arrowUpRight" size={17}/></a></div><div class="play-hero-art"><img src={getArtwork('overworld')} alt="Ilustração conceitual do Mundo Principal"/><span>UM UNIVERSO PARA DESCOBRIR</span></div></section>
  <section class="container play-intro"><span class="kicker">ANTES DE COMEÇAR</span><h2>Você conhece Minecraft.<br /><em>Mas este mundo tem outras regras.</em></h2><p>O Minecraft 2 mistura exploração, criaturas, engenharia e magia. Alguns sistemas são exclusivos de determinadas dimensões e outros ainda estão em desenvolvimento. Use este guia como orientação inicial, não como um roteiro obrigatório.</p></section>
  <section class="container section-spacing small-top" aria-label="Etapas do guia">{guides.map((g, i) => <article class="guide-chapter"><div class="guide-chapter-index">{g.n}<span>/ 04</span></div><div class="guide-chapter-body"><span class="kicker">{g.tag}</span><h3>{g.title}</h3><p>{g.desc}</p><ul>{g.details.map(d => <li>{d}</li>)}</ul><a class="text-link" href={`${base}/wiki/${g.link}/`}>{g.label} <Icon name="arrowUpRight" size={17}/></a></div><div class="guide-chapter-decor"><Icon name={i===0?'compass':i===1?'globe':i===2?'sparkles':'shield'} size={43} strokeWidth={1}/></div></article>)}</section>
  <section class="container step-next"><div><span class="kicker">QUER IR MAIS LONGE?</span><h2>Descubra os detalhes na wiki.</h2><p>Guias completos de dimensões, portais, mecânicas especiais e dicas para explorar com mais confiança.</p></div><a class="btn btn-primary" href={`${base}/wiki/`}>Explorar a wiki <Icon name="arrowRight" size={18}/></a></section>
</Base>
