---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const destination = `${base}/como-jogar/`;
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><meta name="robots" content="noindex"/><title>Redirecionando… | Minecraft 2</title></head><body><p>Esta página mudou. <a href={destination}>Abrir a nova página</a>.</p></body></html>
